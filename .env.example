# Example Environment Variables
# Copy this file to .env and update values for your environment
# DO NOT commit .env to version control!

# PostgreSQL Configuration
POSTGRES_DB=librarydb
POSTGRES_USER=libraryuser
POSTGRES_PASSWORD=librarypass
POSTGRES_PORT=5432

# API Configuration
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# Database Seeding
# Set to true only for initial setup
NEED_SEED=false

# Domain Configuration (for Traefik)
# Change to your actual domain in production
DOMAIN=localhost

# Traefik Configuration
# Let's Encrypt email for SSL certificates
LETSENCRYPT_EMAIL=admin@example.com

# Traefik Log Level (DEBUG, INFO, WARN, ERROR)
TRAEFIK_LOG_LEVEL=INFO

# Optional: Application Insights (for production monitoring)
# APPLICATIONINSIGHTS_CONNECTION_STRING=your-connection-string
